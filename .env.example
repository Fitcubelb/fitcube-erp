# Copy this file to .env for local development (optional — without it, the
# app just uses a local SQLite file at server/db/fitcube.db).
#
# In production (Render), set these as environment variables in the Render
# dashboard instead of committing a .env file — see README.md.

# From `turso db show <db-name> --url` after creating a free Turso database:
TURSO_DATABASE_URL=
# From `turso db tokens create <db-name>`:
TURSO_AUTH_TOKEN=

PORT=3000

# Optional — only needed if you want WhatsApp reminders to send fully
# automatically (no tap-to-send). Without these, the "Remind" / "WhatsApp"
# buttons still work for free — they just open WhatsApp with the message
# pre-filled instead. See README.md "WhatsApp reminders" section.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=session_reminder
WHATSAPP_TEMPLATE_LANG=en_US
